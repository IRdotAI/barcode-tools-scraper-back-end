# FlashProxy residential proxy credentials
# Get these from your FlashProxy dashboard after signing up
PROXY_HOST=gate.flashproxy.com
PROXY_PORT=1000
PROXY_USER=your_username
PROXY_PASS=your_password

# Optional: proxy protocol (http or socks5, default http)
PROXY_PROTOCOL=http

# Optional: target country for proxy exit node
PROXY_COUNTRY=gb
